{
  "name": "cosmic-zebra-refactor-2025",
  "displayName": "Cosmic Zebra Refactor",
  "description": "A unique minimal VSCode extension for refactoring experiments",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cosmic-zebra-refactor.quantumSplit",
        "title": "Quantum Split Analysis"
      }
    ]
  },
  "enabledApiProposals": [
    "uriHandler"
  ],
  "scripts": {
    "build": "bun run esbuild.js",
    "package": "bun run esbuild.js --production"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.101.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.5.0",
    "esbuild": "^0.25.5",
    "eslint": "^9.25.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.3"
  },
  "private": true
}
